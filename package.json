{
  "name": "dm-ruling-bot",
  "version": "0.1.0",
  "private": true,
  "description": "デュエル・マスターズ裁定確認API + モバイルアプリ",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "embeddings:rules": "node dist/scripts/generateRuleEmbeddings.js",
    "cards:index": "node dist/scripts/buildCardIndex.js",
    "eval:retrieval": "tsx tests/retrieval/evaluateRetrieval.ts",
    "eval:retrieval:qa": "tsx tests/retrieval/evaluateQaRetrieval.ts",
    "extract:qa-cases": "tsx src/scripts/extractQaCasesFromCorrections.ts",
    "keyword-abilities:index": "node dist/scripts/buildKeywordAbilityIndex.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^14.2.0",
    "pdf-parse": "^1.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
