PORT=3000

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# /login コマンドでログインできる有効な公認ジャッジIDのカンマ区切りリスト(例: J001,J002)
VALID_JUDGE_IDS=

LLM_API_KEY=

# Voyage AI embedding(総合ルールの意味検索)。未設定でも動作し、その場合は
# 既存のキーワード検索のみで裁定を生成する。
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4

# ハイブリッド検索(キーワード検索+embedding検索)のスコア統合設定
SEARCH_EMBEDDING_WEIGHT=0.75
SEARCH_KEYWORD_WEIGHT=0.25
SEARCH_SEMANTIC_CANDIDATES=20
SEARCH_FINAL_RESULTS=5

DATABASE_URL=./data/cache.db

DM_CARD_BASE_URL=https://dm.takaratomy.co.jp/card/
DM_QA_URL=https://dm.takaratomy.co.jp/rule/qa/
DM_RULE_CHANGE_URL=https://dm.takaratomy.co.jp/rule/rulechange/change/
DM_GENERAL_RULE_PAGE_URL=https://dm.takaratomy.co.jp/rule/rulechange/

ENABLE_DEBUG_ROUTES=true
