PORT=3000

# 起動のたびに、まだDB(judgeテーブル)に存在しないIDだけが差分シードされる、
# 有効な公認ジャッジIDのカンマ区切りリスト(例: J001,J002、既存の行は上書きしない)。
# 以後の追加・削除はモバイルアプリの管理者機能(/api/judges)で行う。削除したIDが
# ここに残っていると、次回起動時に再シードされ復活する点に注意。
VALID_JUDGE_IDS=
# 同じく起動のたびに差分シードされる、管理者権限を持つジャッジIDのカンマ区切りリスト。
# 管理者はモバイルアプリの訂正記録に加えて、ジャッジの登録・削除ができる。
ADMIN_JUDGE_IDS=

LLM_API_KEY=

# Voyage AI embedding(総合ルールの意味検索)。未設定でも動作し、その場合は
# 既存のキーワード検索のみで裁定を生成する。
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4

# ハイブリッド検索(キーワード検索+embedding検索)のスコア統合設定
SEARCH_EMBEDDING_WEIGHT=0.75
SEARCH_KEYWORD_WEIGHT=0.25
SEARCH_SEMANTIC_CANDIDATES=20
SEARCH_FINAL_RESULTS=5

DATABASE_URL=./data/cache.db

DM_CARD_BASE_URL=https://dm.takaratomy.co.jp/card/
DM_QA_URL=https://dm.takaratomy.co.jp/rule/qa/
DM_RULE_CHANGE_URL=https://dm.takaratomy.co.jp/rule/rulechange/change/
DM_GENERAL_RULE_PAGE_URL=https://dm.takaratomy.co.jp/rule/rulechange/

ENABLE_DEBUG_ROUTES=true

# Firebase Cloud Messaging送信用サービスアカウントJSON(1行のbase64文字列)。
# 未設定でも動作し、その場合はプッシュ通知だけが無効化される(裁定生成・
# ポーリングでの結果取得は引き続き可能)。
# 発行方法: Firebaseコンソール > プロジェクトの設定 > サービスアカウント から
# Node.js用の秘密鍵(JSON)をダウンロードし、`base64 -w0 service-account.json`等で変換する。
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# 同時実行中の裁定ジョブ数の上限(非同期化に伴うLLM APIコスト・レート保護用)
RULING_JOB_MAX_CONCURRENCY=5

# 完了/失敗した裁定ジョブ(ruling_job)の保持期間(日)
RULING_JOB_RETENTION_DAYS=3

# 無料で利用できる月間の質問数(これを超えるとサブスクリプションが必須)
RULING_FREE_MONTHLY_LIMIT=10

# RevenueCat Webhookの共有シークレット(RevenueCatダッシュボードのWebhook設定と同じ値)
REVENUECAT_WEBHOOK_SECRET=
# RevenueCatのSecret API Key(REST API呼び出し用)
REVENUECAT_API_KEY=
# RevenueCatダッシュボードで設定したエンタイトルメントID
REVENUECAT_ENTITLEMENT_ID=unlimited_questions
