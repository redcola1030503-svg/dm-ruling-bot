<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- プッシュ通知表示に必要(Android 13以降、実行時に別途ユーザー許可も要る) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- AdMobバナー広告で広告IDを使用するために必要(Android 13以降は明示しないとゼロIDになる) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>
    <application
        android:label="デュエマ裁定確認"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- notificationブロック付きFCMメッセージの既定通知チャンネル -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="ruling_result" />
        <!-- AdMob App ID(本番、AdMobアカウントで発行したもの) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-9649943716514595~3734601535" />
        <!-- google_mobile_adsが既定でtrueを挿入するが、WorkManager経由のバックグラウンド初期化が
             androidx.work.impl.WorkDatabase生成失敗で起動時クラッシュを起こしたため無効化する -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="false"
            tools:replace="android:value" />
        <!-- WorkManagerの自動初期化自体を無効化する。このアプリはWorkManagerを直接使用しておらず、
             androidx.startup経由の自動初期化(WorkDatabase生成)がクラッシュの原因になっていたため。 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcherで外部ブラウザ(dm-wiki・出典元)を開くために必要 -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
